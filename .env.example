# Supply credentials only in your shell or a local ignored .env.
# Core retrieval and table reproduction do not load .env or call an API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional official GoS checkout for export-native:
GOSKILLS_OFFICIAL_ROOT=

# Shared official graph/vector and optional index construction settings:
GOS_EMBEDDING_MODEL=openai/text-embedding-3-small
GOS_EMBEDDING_DIM=1536
GOS_ENABLE_QUERY_REWRITE=false
GOS_LLM_MODEL=openai/gpt-5.4
