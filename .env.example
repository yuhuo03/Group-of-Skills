# ──────────────────────────────────────────────────────────────────────────────
# Group of Skills -- Environment Configuration
# Copy to .env, replace the placeholders, then load it in your shell:
# set -a; . ./.env; set +a
# ──────────────────────────────────────────────────────────────────────────────

# ── API provider ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key
# Optional: uncomment for an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://YOUR-ENDPOINT/v1

# ── Source graph construction (upstream GoS) ──────────────────────────────────
# Choose the provider/model used to build the skill graph.
GOS_LLM_MODEL=openai/YOUR_MODEL_NAME
GOS_ENABLE_QUERY_REWRITE=false

# ── Embedding provider ────────────────────────────────────────────────────────
# Indexing and retrieval must use the same model and dimension.
GOS_EMBEDDING_MODEL=openai/text-embedding-3-small
GOS_EMBEDDING_DIM=1536

# ── Upstream checkout for workspace export ────────────────────────────────────
GOSKILLS_OFFICIAL_ROOT=./data/external/graph-of-skills
